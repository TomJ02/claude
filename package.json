{
  "name": "singe-de-bureau",
  "productName": "Singe de bureau",
  "version": "1.0.0",
  "description": "Un petit singe 3D qui vit sur votre bureau, par-dessus vos fenêtres (desktop pet Electron + Three.js).",
  "main": "src/main/main.js",
  "author": "Singe de bureau",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "icons": "node scripts/generate-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "optionalDependencies": {
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.singedebureau.app",
    "productName": "Singe de bureau",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/three/src/**",
      "!node_modules/three/build/three.cjs",
      "!node_modules/three/build/three.webgpu*.js",
      "!node_modules/three/build/three.tsl.js",
      "!node_modules/three/examples/**",
      "node_modules/three/examples/jsm/loaders/GLTFLoader.js",
      "node_modules/three/examples/jsm/utils/BufferGeometryUtils.js",
      "node_modules/three/examples/jsm/utils/SkeletonUtils.js"
    ],
    "asarUnpack": [
      "node_modules/@koromix/**"
    ],
    "onNodeModuleFile": "./scripts/include-three-addons.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Singe de bureau",
      "artifactName": "Singe-de-bureau-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Singe-de-bureau-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.entertainment",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Game"
    }
  }
}
